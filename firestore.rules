rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'breakthroughcollege03@gmail.com' ||
        exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid))
      );
    }

    function getUserTenantId() {
      return (isSignedIn() && exists(/databases/$(database)/documents/tenantUsers/$(request.auth.uid)))
        ? get(/databases/$(database)/documents/tenantUsers/$(request.auth.uid)).data.tenantId
        : '';
    }

    match /tenants/{tenantId} {
      allow read: if true;
      allow write: if true;
    }

    match /tenantUsers/{userId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId) || true;
    }

    match /superAdmins/{adminId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    match /sales/{saleId} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    match /devices/{deviceId} {
      allow read, write: if true;
    }

    match /payments/{paymentId} {
      allow read, write: if true;
    }

    match /inventory/{inventoryId} {
      allow read, write: if true;
    }

    match /suppliers/{supplierId} {
      allow read, write: if true;
    }

    match /receipts/{receiptId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /purchases/{purchaseId} {
      allow read, write: if true;
    }

    match /stockMovements/{movementId} {
      allow read, write: if true;
    }

    match /categories/{categoryId} {
      allow read, write: if true;
    }

    match /customers/{customerId} {
      allow read, write: if true;
    }

    match /shifts/{shiftId} {
      allow read, write: if true;
    }

    match /tables/{tableId} {
      allow read, write: if true;
    }

    match /rooms/{roomId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}

